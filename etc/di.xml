<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="MageBooster\License\Model\Products">
        <arguments>
            <argument name="products" xsi:type="array">
                <item name="contract" xsi:type="array">
                    <item name="label" xsi:type="string">Contract (Turkish distance sales contract)</item>
                    <item name="codes" xsi:type="array">
                        <item name="contract" xsi:type="string">contract</item>
                        <item name="contract-hyva" xsi:type="string">contract-hyva</item>
                    </item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="MageBooster\Contract\Model\Config">
        <arguments>
            <argument name="licenceCodes" xsi:type="array">
                <item name="contract" xsi:type="string">contract</item>
            </argument>
        </arguments>
    </type>
    <type name="MageBooster\Contract\Model\Mail\AttachmentContext" shared="true"/>
    <type name="Magento\Sales\Model\Order\Email\Sender\OrderSender">
        <plugin name="magebooster_contract_context" type="MageBooster\Contract\Plugin\OrderSenderContext"/>
    </type>
    <type name="Magento\Framework\Mail\TransportInterface">
        <plugin name="magebooster_contract_attach" type="MageBooster\Contract\Plugin\AttachToOrderEmail" sortOrder="1000"/>
    </type>
    <virtualType name="MageBoosterContractLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">magebooster_contract</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">MageBoosterContractLogHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="MageBoosterContractLogHandler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/magebooster_contract.log</argument>
        </arguments>
    </virtualType>
    <type name="MageBooster\Contract\Model\Archiver">
        <arguments>
            <argument name="logger" xsi:type="object">MageBoosterContractLogger</argument>
        </arguments>
    </type>
    <type name="MageBooster\Contract\Model\Mail\Attacher">
        <arguments>
            <argument name="logger" xsi:type="object">MageBoosterContractLogger</argument>
        </arguments>
    </type>
    <type name="MageBooster\Contract\Plugin\OrderSenderContext">
        <arguments>
            <argument name="logger" xsi:type="object">MageBoosterContractLogger</argument>
        </arguments>
    </type>
    <type name="MageBooster\Contract\Observer\ArchiveOnOrderSubmit">
        <arguments>
            <argument name="logger" xsi:type="object">MageBoosterContractLogger</argument>
        </arguments>
    </type>
</config>
