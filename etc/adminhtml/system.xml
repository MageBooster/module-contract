<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="magebooster_license">
            <group id="serials">
                <field id="contract" translate="label comment" type="text" sortOrder="30" showInDefault="1">
                    <label>Contract (Turkish distance sales contract)</label>
                    <comment>Serial number, starts with MB1.</comment>
                </field>
            </group>
        </section>
        <section id="magebooster_contract" translate="label" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Contract</label>
            <tab>magebooster</tab>
            <resource>MageBooster_Contract::config</resource>
            <group id="general" translate="label comment" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <comment><![CDATA[Fills the texts of Stores > Terms and Conditions with the order data at checkout and saves the filled text with every order (HTML and PDF). Write the texts with {{TAGS}}; the tag list is shown under the Terms and Conditions edit form. Turn on "Enable Terms and Conditions" in Stores > Configuration > Sales > Checkout > Checkout Options. Needs a serial number (MageBooster > Licenses). The sample Turkish texts are drafts: have them reviewed by your lawyer before use.]]></comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="attach_pdf" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Attach PDF to the order confirmation email</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Without the dompdf library the HTML file is attached instead.</comment>
                </field>
                <field id="attach_html" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Attach HTML to the order confirmation email</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="tax_office_attribute" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Tax office address attribute code</label>
                    <comment>Optional. Code of a customer address attribute that holds the tax office (vergi dairesi), for example tax_office. Empty = not used.</comment>
                    <validate>validate-code</validate>
                </field>
            </group>
            <group id="seller" translate="label comment" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Seller details</label>
                <comment>Used by the {{COMPANY_*}} tags. Empty fields fall back to General > Store Information and the general store email.</comment>
                <field id="name" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Company name</label>
                    <comment>Full legal name.</comment>
                </field>
                <field id="short_name" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Short company name</label>
                </field>
                <field id="address" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Address</label>
                </field>
                <field id="city" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>District / city</label>
                </field>
                <field id="state" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Province / region</label>
                </field>
                <field id="country" translate="label comment" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Country</label>
                </field>
                <field id="telephone" translate="label comment" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Telephone</label>
                </field>
                <field id="fax" translate="label comment" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Fax</label>
                </field>
                <field id="website" translate="label comment" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Website</label>
                    <comment>Empty = the store base URL.</comment>
                </field>
                <field id="email" translate="label comment" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Email</label>
                </field>
                <field id="tax_office" translate="label comment" type="text" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Tax office</label>
                </field>
                <field id="tax_number" translate="label comment" type="text" sortOrder="120" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Tax number</label>
                </field>
                <field id="mersis" translate="label comment" type="text" sortOrder="130" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>MERSIS number</label>
                </field>
            </group>
        </section>
    </system>
</config>
