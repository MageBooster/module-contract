/**
 * @var \MageBooster\Contract\Block\Order\Contracts $block
 * @var \Magento\Framework\Escaper $escaper
 */
$records = $block->getRecords();
if (!$records) {
    return;
}
?>
<div class="block block-order-details-view mb-contract-records">
    <div class="block-title">
        <strong><?= $escaper->escapeHtml(__('Contracts')) ?></strong>
    </div>
    <div class="block-content">
        <ul class="items">
            <?php foreach ($records as $record): ?>
                <li class="item">
                    <a href="<?= $escaper->escapeUrl($block->getDownloadUrl($record)) ?>" class="action download">
                        <span><?= $escaper->escapeHtml(__('Download %1', $record->getAgreementName())) ?></span>
                    </a>
                </li>
            <?php endforeach; ?>
        </ul>
    </div>
</div>
